# Laravel API base (no trailing slash). Must be a sibling subdomain of the
# dashboard so the Sanctum session cookie is shared (same registrable domain).
VITE_API_URL=https://qayema.test

# Where to bounce visitors who aren't logged in (Laravel login page).
VITE_LOGIN_URL=https://qayema.test/get-started

# Pusher's public key and cluster: live orders. Empty: the dashboard checks once a minute.
VITE_PUSHER_KEY=
VITE_PUSHER_CLUSTER=eu
